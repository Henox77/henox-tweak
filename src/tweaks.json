        "if (-not $guid) { throw 'Güç planı oluşturulamadı' }",
        "powercfg -changename $guid 'Henox Nihai Performans' | Out-Null",
        "powercfg -setactive $guid"
      ],
      "undo": [
        "powercfg -setactive 381b4222-f694-41f0-9685-ff5bb260df2e",
        "powercfg /list | Select-String 'Henox' | ForEach-Object { $g = [regex]::Match($_.Line, '[0-9a-fA-F-]{36}').Value; if ($g) { powercfg -delete $g } }"
      ]
    },
