<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Henox Tweak" Width="1280" Height="820" MinWidth="1060" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Bg}" Foreground="{DynamicResource Txt}"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display" ResizeMode="CanResize">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Tema fırçaları: kod tarafından açık/koyu temaya göre animasyonla değiştirilir -->
    <SolidColorBrush x:Key="Bg" Color="#0E0F12"/>
    <SolidColorBrush x:Key="Surface" Color="#15171C"/>
    <SolidColorBrush x:Key="Surface2" Color="#1C1F26"/>
    <SolidColorBrush x:Key="Surface3" Color="#262A34"/>
    <SolidColorBrush x:Key="Line" Color="#23262F"/>
    <SolidColorBrush x:Key="Line2" Color="#353841"/>
    <SolidColorBrush x:Key="Txt" Color="#EDEEF3"/>
    <SolidColorBrush x:Key="Mut" Color="#A3A7B2"/>
    <SolidColorBrush x:Key="Dim" Color="#6E727C"/>
    <SolidColorBrush x:Key="Acc" Color="#8B5CF6"/>
    <SolidColorBrush x:Key="AccSoft" Color="#2E8B5CF6"/>
    <SolidColorBrush x:Key="OnAcc" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Ok" Color="#4ADE80"/>
    <SolidColorBrush x:Key="OkSoft" Color="#1F4ADE80"/>
    <SolidColorBrush x:Key="Warn" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarnSoft" Color="#1FFBBF24"/>
    <SolidColorBrush x:Key="Err" Color="#F87171"/>
    <SolidColorBrush x:Key="ErrSoft" Color="#1FF87171"/>
    <SolidColorBrush x:Key="Info" Color="#B39DFF"/>
    <SolidColorBrush x:Key="InfoSoft" Color="#1FB39DFF"/>
    <SolidColorBrush x:Key="Hover" Color="#12FFFFFF"/>
    <SolidColorBrush x:Key="Overlay" Color="#B3000000"/>
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Mono">Cascadia Mono, Consolas</FontFamily>
    <CubicEase x:Key="Ease" EasingMode="EaseOut"/>

    <!-- Kaydırma çubuğu -->
    <Style x:Key="ThumbS" TargetType="Thumb">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border CornerRadius="4" Background="{DynamicResource Line2}"/></ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="10"/><Setter Property="MinWidth" Value="10"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Grid Background="Transparent"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.Thumb><Thumb Style="{StaticResource ThumbS}" Margin="2"/></Track.Thumb></Track></Grid>
        </ControlTemplate></Setter.Value></Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/><Setter Property="MinHeight" Value="10"/>
          <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track"><Track.Thumb><Thumb Style="{StaticResource ThumbS}" Margin="2"/></Track.Thumb></Track></Grid></ControlTemplate>
          </Setter.Value></Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- Düğmeler: hover katmanı yumuşak geçişle görünür, basınca hafif küçülür -->
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Txt}"/>
      <Setter Property="Background" Value="{DynamicResource Surface2}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Line2}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="RenderTransform"><Setter.Value><ScaleTransform/></Setter.Value></Setter>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"/>
            <Border x:Name="hov" Background="{DynamicResource Hover}" CornerRadius="7" Opacity="0"/>
            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="hov" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.97" Duration="0:0:0.06"/>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.97" Duration="0:0:0.06"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.12"/>
                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.12"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="BtnPri" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="{DynamicResource Acc}"/><Setter Property="BorderBrush" Value="{DynamicResource Acc}"/><Setter Property="Foreground" Value="{DynamicResource OnAcc}"/>
    </Style>
    <Style x:Key="BtnGhost" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource Mut}"/><Setter Property="FontWeight" Value="Normal"/>
    </Style>
    <Style x:Key="BtnIcon" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
      <Setter Property="Width" Value="36"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="0"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/><Setter Property="FontSize" Value="15"/><Setter Property="Foreground" Value="{DynamicResource Mut}"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>
    <Style x:Key="BtnCap" TargetType="Button">
      <Setter Property="Width" Value="46"/><Setter Property="Height" Value="56"/><Setter Property="Foreground" Value="{DynamicResource Mut}"/>
      <Setter Property="FontFamily" Value="{StaticResource Icons}"/><Setter Property="FontSize" Value="10"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Border x:Name="hov" Background="{DynamicResource Hover}" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hov" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="{DynamicResource Txt}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="BtnClose" TargetType="Button" BasedOn="{StaticResource BtnCap}">
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Background="Transparent">
            <Border x:Name="hov" Background="#E81123" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="hov" Property="Opacity" Value="1"/><Setter Property="Foreground" Value="White"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <!-- Kart düğmesi (Onarım sayfası) -->
    <Style x:Key="Card" TargetType="Button" BasedOn="{StaticResource Btn}">
      <Setter Property="Width" Value="262"/><Setter Property="Margin" Value="0,0,12,12"/><Setter Property="Padding" Value="16,14"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <!-- Üst sekmeler: alt çizgi ortadan dışa doğru açılır -->
    <Style x:Key="Tab" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{DynamicResource Mut}"/><Setter Property="FontSize" Value="13.5"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent" Height="56">
            <Border x:Name="pill" Background="{DynamicResource Hover}" CornerRadius="7" Margin="0,12" Opacity="0"/>
            <ContentPresenter Margin="13,0" VerticalAlignment="Center"/>
            <Border x:Name="bar" Height="2.5" CornerRadius="1.5" Background="{DynamicResource Acc}" VerticalAlignment="Bottom" Margin="10,0" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><ScaleTransform ScaleX="0"/></Border.RenderTransform>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Txt}"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="pill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="pill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Txt}"/>
              <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.28" EasingFunction="{StaticResource Ease}"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="bar" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Onay kutusu: dolgu solarak gelir, tik işareti büyüyerek çıkar -->
    <Style x:Key="Chk" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Txt}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="17" Height="17" VerticalAlignment="Top" Margin="0,1,10,0">
              <Border x:Name="box" CornerRadius="4.5" BorderThickness="1.5" BorderBrush="{DynamicResource Line2}" Background="{DynamicResource Surface}"/>
              <Border x:Name="fill" CornerRadius="4.5" Background="{DynamicResource Acc}" Opacity="0"/>
              <Path x:Name="mark" Data="M3.4,8.6 L7,12 L13.6,5" Stroke="White" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                    Opacity="0" RenderTransformOrigin="0.5,0.5"><Path.RenderTransform><ScaleTransform ScaleX="0.4" ScaleY="0.4"/></Path.RenderTransform></Path>
            </Grid>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{DynamicResource Acc}"/></Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                <DoubleAnimation Storyboard.TargetName="mark" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12"/>
                <DoubleAnimation Storyboard.TargetName="mark" Storyboard.TargetProperty="RenderTransform.ScaleX" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                <DoubleAnimation Storyboard.TargetName="mark" Storyboard.TargetProperty="RenderTransform.ScaleY" To="1" Duration="0:0:0.22"><DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction></DoubleAnimation>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="fill" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12"/>
                <DoubleAnimation Storyboard.TargetName="mark" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1"/>
                <DoubleAnimation Storyboard.TargetName="mark" Storyboard.TargetProperty="RenderTransform.ScaleX" To="0.4" Duration="0:0:0.12"/>
                <DoubleAnimation Storyboard.TargetName="mark" Storyboard.TargetProperty="RenderTransform.ScaleY" To="0.4" Duration="0:0:0.12"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <!-- Anahtar (toggle): topuz kayar, iz rengi yumuşakça dolar -->
    <Style x:Key="Sw" TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Txt}"/><Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid Width="38" Height="21" VerticalAlignment="Top" Margin="0,0,12,0">
              <Border CornerRadius="10.5" Background="{DynamicResource Surface3}" BorderBrush="{DynamicResource Line2}" BorderThickness="1"/>
              <Border x:Name="on" CornerRadius="10.5" Background="{DynamicResource Acc}" Opacity="0"/>
              <Grid x:Name="knob" Width="13" Height="13" HorizontalAlignment="Left" Margin="4,0,0,0">
                <Grid.RenderTransform><TranslateTransform X="0"/></Grid.RenderTransform>
                <Ellipse Fill="{DynamicResource Mut}"/>
                <Ellipse x:Name="knobOn" Fill="White" Opacity="0"/>
              </Grid>
            </Grid>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Trigger.EnterActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="RenderTransform.X" To="17" Duration="0:0:0.22" EasingFunction="{StaticResource Ease}"/>
                <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="knobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2"/>
              </Storyboard></BeginStoryboard></Trigger.EnterActions>
              <Trigger.ExitActions><BeginStoryboard><Storyboard>
                <DoubleAnimation Storyboard.TargetName="knob" Storyboard.TargetProperty="RenderTransform.X" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource Ease}"/>
                <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                <DoubleAnimation Storyboard.TargetName="knobOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
              </Storyboard></BeginStoryboard></Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Search" TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Txt}"/><Setter Property="CaretBrush" Value="{DynamicResource Acc}"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="bd" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="34">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" FontSize="13" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ScrollViewer x:Name="PART_ContentHost" Grid.Column="1" VerticalAlignment="Center"/>
              <TextBlock x:Name="ph" Grid.Column="1" Text="{TemplateBinding Tag}" Foreground="{DynamicResource Dim}" IsHitTestVisible="False" Margin="2,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
              <Border Grid.Column="2" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="4" Padding="5,1" VerticalAlignment="Center">
                <TextBlock Text="Ctrl F" FontSize="10.5" Foreground="{DynamicResource Dim}"/>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value=""><Setter TargetName="ph" Property="Visibility" Value="Visible"/></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Acc}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{DynamicResource Txt}"/><Setter Property="FontSize" Value="12.5"/><Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="9" Padding="13,11" MaxWidth="420" Margin="8">
            <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.35"/></Border.Effect>
            <ContentPresenter/>
          </Border>
        </ControlTemplate></Setter.Value></Setter>
    </Style>

    <Style x:Key="Bar" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource Surface}"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="0,0,0,1"/><Setter Property="Padding" Value="22,11"/>
    </Style>
    <Style x:Key="H" TargetType="TextBlock">
      <Setter Property="FontSize" Value="11.5"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="{DynamicResource Acc}"/><Setter Property="FontFamily" Value="{StaticResource Mono}"/>
    </Style>
  </Window.Resources>

  <Border x:Name="Root" Background="{DynamicResource Bg}">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="32"/></Grid.RowDefinitions>

      <!-- ÜST ÇUBUK (pencere başlığı da burası) -->
      <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Margin="16,0,14,0" VerticalAlignment="Center">
            <Border Width="28" Height="28" CornerRadius="8" Background="{DynamicResource Acc}">
              <TextBlock Text="h" Foreground="White" FontWeight="Bold" FontSize="17" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
            </Border>
            <TextBlock FontSize="15.5" FontWeight="Bold" VerticalAlignment="Center" Margin="10,0,0,0"><Run Text="henox"/><Run Text="/tweak" Foreground="{DynamicResource Acc}"/></TextBlock>
          </StackPanel>
          <StackPanel x:Name="TabPanel" Grid.Column="1" Orientation="Horizontal"/>
          <TextBox x:Name="GlobalSearch" Grid.Column="3" Style="{StaticResource Search}" Width="250" Tag="Bu sekmede ara..." VerticalAlignment="Center" Margin="0,0,8,0"/>
          <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
            <Button x:Name="BtnTheme" Style="{StaticResource BtnIcon}" Content="&#xE708;" ToolTip="Açık / koyu tema"/>
            <Button x:Name="BtnAbout" Style="{StaticResource BtnIcon}" Content="&#xE946;" ToolTip="Hakkında, yedekler ve geri alma"/>
          </StackPanel>
          <StackPanel Grid.Column="5" Orientation="Horizontal">
            <Button x:Name="BtnMin" Style="{StaticResource BtnCap}" Content="&#xE921;"/>
            <Button x:Name="BtnMax" Style="{StaticResource BtnCap}" Content="&#xE922;"/>
            <Button x:Name="BtnClose" Style="{StaticResource BtnClose}" Content="&#xE8BB;"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- SAYFALAR -->
      <Grid x:Name="Pages" Grid.Row="1">

        <!-- PANEL -->
        <ScrollViewer x:Name="PagePanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="28,24,28,28">
            <TextBlock x:Name="OvHello" FontSize="24" FontWeight="Bold" Text="Merhaba"/>
            <TextBlock Foreground="{DynamicResource Mut}" Margin="0,4,0,18" Text="Sisteminin gerçek durumu ve sana özel öneriler. Bu sayfa hiçbir şeyi değiştirmez."/>
            <WrapPanel x:Name="OvMeters"/>
            <WrapPanel x:Name="OvCards" Margin="0,4,0,0"/>
            <TextBlock Style="{StaticResource H}" Text="SANA ÖZEL ÖNERİLER" Margin="0,18,0,10"/>
            <StackPanel x:Name="OvRecs"><TextBlock Text="Sistem taranıyor..." Foreground="{DynamicResource Dim}"/></StackPanel>
            <TextBlock Style="{StaticResource H}" Text="HIZLI İŞLEMLER" Margin="0,22,0,10"/>
            <WrapPanel>
              <Button x:Name="BtnQuickRec" Style="{StaticResource BtnPri}" Content="Önerilen tweakleri seç" Margin="0,0,10,10"/>
              <Button x:Name="BtnQuickGame" Style="{StaticResource Btn}" Content="Oyuncu tweaklerini seç" Margin="0,0,10,10"/>
              <Button x:Name="BtnQuickClean" Style="{StaticResource Btn}" Content="Temizlik taraması" Margin="0,0,10,10"/>
              <Button x:Name="BtnQuickRestore" Style="{StaticResource Btn}" Content="Geri yükleme noktası oluştur" Margin="0,0,10,10"/>
              <Button x:Name="BtnQuickRefresh" Style="{StaticResource BtnGhost}" Content="↻  Yeniden tara" Margin="0,0,10,10"/>
            </WrapPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- UYGULAMALAR -->
        <Grid x:Name="PageApps" Visibility="Collapsed">
          <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0" Padding="16,18">
            <StackPanel>
              <TextBlock Style="{StaticResource H}" Text="UYGULAMALAR"/>
              <TextBlock x:Name="TxtAppCount" Foreground="{DynamicResource Mut}" Margin="0,6,0,14" Text="0 seçili"/>
              <Button x:Name="BtnAppInstall" Style="{StaticResource BtnPri}" Content="Seçilenleri kur" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
              <Button x:Name="BtnAppUninstall" Style="{StaticResource Btn}" Content="Seçilenleri kaldır" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
              <Button x:Name="BtnAppUpgrade" Style="{StaticResource Btn}" Content="Kurulu her şeyi güncelle" HorizontalContentAlignment="Left" Margin="0,0,0,18"/>
              <Button x:Name="BtnAppInstalled" Style="{StaticResource Btn}" Content="Kurulu olanları seç" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
              <Button x:Name="BtnAppShowSel" Style="{StaticResource Btn}" Content="Sadece seçilenleri göster" HorizontalContentAlignment="Left" Margin="0,0,0,8"/>
              <Button x:Name="BtnAppClear" Style="{StaticResource BtnGhost}" Content="Seçimi temizle" HorizontalContentAlignment="Left" Margin="0,0,0,18"/>
              <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Dim}" FontSize="12" LineHeight="18"
                         Text="Programlar Microsoft'un resmi winget deposundan, en güncel sürümüyle ve reklam yazılımı olmadan sessizce kurulur."/>
              <Border x:Name="WingetWarn" Visibility="Collapsed" Background="{DynamicResource ErrSoft}" BorderBrush="{DynamicResource Err}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="winget bulunamadı" FontWeight="SemiBold"/>
                  <TextBlock Text="Microsoft Store'dan 'Uygulama Yükleyicisi'ni kur, sonra Henox Tweak'i yeniden aç." Foreground="{DynamicResource Mut}" TextWrapping="Wrap" Margin="0,4,0,8" FontSize="12"/>
                  <Button x:Name="BtnGetWinget" Style="{StaticResource Btn}" Content="Store'da aç"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="AppList" Margin="20,16,8,20"/></ScrollViewer>
        </Grid>

        <!-- TWEAKLER -->
        <Grid x:Name="PageTweaks" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Bar}">
            <DockPanel>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="BtnTwImport" Style="{StaticResource BtnGhost}" Content="İçe aktar" Padding="10,6"/>
                <Button x:Name="BtnTwExport" Style="{StaticResource BtnGhost}" Content="Dışa aktar" Padding="10,6"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Hazır seçimler" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button x:Name="BtnPresetRec" Style="{StaticResource Btn}" Content="Önerilen" Padding="14,6" Margin="0,0,6,0"/>
                <Button x:Name="BtnPresetGame" Style="{StaticResource Btn}" Content="Oyuncu" Padding="14,6" Margin="0,0,6,0"/>
                <Button x:Name="BtnPresetApplied" Style="{StaticResource Btn}" Content="Uygulanmışları getir" Padding="14,6" Margin="0,0,6,0"/>
                <Button x:Name="BtnPresetNone" Style="{StaticResource BtnGhost}" Content="Temizle" Padding="12,6" Margin="0,0,12,0"/>
                <TextBlock x:Name="TxtTwCount" Foreground="{DynamicResource Dim}" VerticalAlignment="Center" FontSize="12"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="380"/></Grid.ColumnDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="TweakList" Margin="22,6,18,22"/></ScrollViewer>
            <Border Grid.Column="1" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,18,20,22">
                  <TextBlock Style="{StaticResource H}" Text="TERCİHLER"/>
                  <TextBlock Foreground="{DynamicResource Dim}" FontSize="12" Margin="0,3,0,12" TextWrapping="Wrap" Text="Anahtara dokunduğun an uygulanır. Kapatınca eski haline döner."/>
                  <StackPanel x:Name="PrefList"/>
                  <TextBlock Style="{StaticResource H}" Text="DNS SUNUCUSU" Margin="0,22,0,0"/>
                  <TextBlock x:Name="DnsNow" Foreground="{DynamicResource Dim}" FontSize="11.5" Margin="0,4,0,10" TextWrapping="Wrap" FontFamily="{StaticResource Mono}" Text="okunuyor..."/>
                  <WrapPanel x:Name="DnsButtons"/>
                </StackPanel>
              </ScrollViewer>
            </Border>
          </Grid>
          <Border Grid.Row="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="22,10">
            <DockPanel>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <CheckBox x:Name="ChkRestore" Style="{StaticResource Chk}" IsChecked="True" VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Önce geri yükleme noktası" Foreground="{DynamicResource Mut}" FontSize="12.5"/></CheckBox>
                <Button x:Name="BtnTwUndo" Style="{StaticResource Btn}" Content="Seçilenleri geri al" Margin="0,0,8,0"/>
                <Button x:Name="BtnTwApply" Style="{StaticResource BtnPri}" Content="Tweakleri çalıştır"/>
              </StackPanel>
              <TextBlock Foreground="{DynamicResource Dim}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,16,0"
                         Text="Bir tweak'in üzerine gel: ne yaptığını ve kayıt defterinde neyi değiştirdiğini gösterir. Her tweak geri alınabilir."/>
            </DockPanel>
          </Border>
        </Grid>

        <!-- DEBLOAT -->
        <Grid x:Name="PageDebloat" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Bar}">
            <DockPanel>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="BtnDbSafe" Style="{StaticResource Btn}" Content="Güvenli olanları seç" Margin="0,0,8,0"/>
                <Button x:Name="BtnDbRemove" Style="{StaticResource BtnPri}" Content="Seçilenleri kaldır"/>
              </StackPanel>
              <TextBlock Foreground="{DynamicResource Mut}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,16,0" Text="Kaldırılan uygulamalar Microsoft Store'dan tekrar kurulabilir. Soluk görünenler bu bilgisayarda zaten yok."/>
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="DebloatList" Margin="22,18,10,22"/></ScrollViewer>
        </Grid>

        <!-- BAŞLANGIÇ -->
        <Grid x:Name="PageStartup" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Bar}">
            <DockPanel>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="BtnStTaskmgr" Style="{StaticResource BtnGhost}" Content="Görev Yöneticisi'nde aç" Margin="0,0,8,0"/>
                <Button x:Name="BtnStRefresh" Style="{StaticResource Btn}" Content="↻  Yenile"/>
              </StackPanel>
              <TextBlock Foreground="{DynamicResource Mut}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Margin="0,0,16,0" Text="Anahtar kapalıysa program açılışta kendiliğinden başlamaz. Program silinmez. Değişiklik anında uygulanır."/>
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="StartupList" Margin="22,6,22,22"/></ScrollViewer>
        </Grid>

        <!-- TEMİZLİK -->
        <Grid x:Name="PageClean" Visibility="Collapsed">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <Border Style="{StaticResource Bar}">
            <DockPanel>
              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button x:Name="BtnClScan" Style="{StaticResource Btn}" Content="↻  Tara" Margin="0,0,8,0"/>
                <Button x:Name="BtnClRun" Style="{StaticResource BtnPri}" Content="Seçilenleri temizle"/>
              </StackPanel>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtClTotal" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource Acc}" FontFamily="{StaticResource Mono}" Text="—"/>
                <TextBlock Text="   seçili alan temizlenebilir" Foreground="{DynamicResource Dim}" VerticalAlignment="Center"/>
              </StackPanel>
            </DockPanel>
          </Border>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="CleanList" Margin="22,6,22,22"/></ScrollViewer>
        </Grid>

        <!-- ONARIM -->
        <ScrollViewer x:Name="PageRepair" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel x:Name="RepairList" Margin="22,8,22,22"/>
        </ScrollViewer>

        <!-- HAKKINDA -->
        <ScrollViewer x:Name="PageAbout" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
          <StackPanel Margin="32,28,32,28" MaxWidth="780" HorizontalAlignment="Left">
            <StackPanel Orientation="Horizontal">
              <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource Acc}">
                <TextBlock Text="h" Foreground="White" FontWeight="Bold" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-4,0,0"/>
              </Border>
              <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock FontSize="24" FontWeight="Bold"><Run Text="henox"/><Run Text="/tweak" Foreground="{DynamicResource Acc}"/></TextBlock>
                <TextBlock x:Name="TxtAboutVer" Foreground="{DynamicResource Dim}" FontFamily="{StaticResource Mono}" FontSize="12"/>
              </StackPanel>
            </StackPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Mut}" LineHeight="21" Margin="0,18,0,0"
                       Text="Türkçe WinUtil alternatifi: Windows'u hızlandırmak ve sadeleştirmek için yapılmış ücretsiz ve açık kaynak bir araç. WinUtil'den ilham alan bağımsız bir projedir. Kodun tamamı GitHub'da herkese açık; gizlenmiş kod, reklam, telemetri veya ücretli özellik yok."/>
            <TextBlock Style="{StaticResource H}" Text="GÜVENLİK İLKELERİ" Margin="0,24,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Mut}" LineHeight="23">
              • Windows Defender, Güvenlik Duvarı ve UAC'ye asla dokunmaz.<LineBreak/>
              • Her tweak'in orijinal değeri uygulanmadan önce yedeklenir ve geri alınabilir.<LineBreak/>
              • İstersen her işlemden önce Windows geri yükleme noktası oluşturur.<LineBreak/>
              • İnternete yalnızca winget (uygulama kurulumu) için çıkar, hiçbir veri göndermez.<LineBreak/>
              • Yaptığı her şey günlük dosyasına yazılır.
            </TextBlock>
            <TextBlock Style="{StaticResource H}" Text="YEDEKLER VE GÜNLÜKLER" Margin="0,24,0,8"/>
            <TextBlock x:Name="TxtBackupInfo" TextWrapping="Wrap" Foreground="{DynamicResource Mut}" FontFamily="{StaticResource Mono}" FontSize="12" LineHeight="20"/>
            <WrapPanel Margin="0,14,0,0">
              <Button x:Name="BtnOpenData" Style="{StaticResource Btn}" Content="Yedek ve günlük klasörünü aç" Margin="0,0,10,10"/>
              <Button x:Name="BtnUndoAll" Style="{StaticResource Btn}" Content="Yapılan tüm tweakleri geri al" Margin="0,0,10,10"/>
              <Button x:Name="BtnSite" Style="{StaticResource BtnGhost}" Content="tweak.henox.dev ↗" Margin="0,0,10,10"/>
              <Button x:Name="BtnGithub" Style="{StaticResource BtnGhost}" Content="GitHub ↗" Margin="0,0,10,10"/>
            </WrapPanel>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Dim}" Margin="0,18,0,0" FontSize="12"
                       Text="MIT Lisansı · Olduğu gibi sunulur. Microsoft ile bağlantılı değildir."/>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- GÜNLÜK ÇEKMECESİ -->
      <Border x:Name="LogDrawer" Grid.Row="2" Height="0" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" ClipToBounds="True">
        <RichTextBox x:Name="LogBox" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Mut}"
                     FontFamily="{StaticResource Mono}" FontSize="12" Padding="20,8" VerticalScrollBarVisibility="Auto"/>
      </Border>

      <!-- DURUM ÇUBUĞU -->
      <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="18,0,10,0">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Ok}" VerticalAlignment="Center" Margin="0,0,9,0"/>
          <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{DynamicResource Mut}" FontSize="12" VerticalAlignment="Center" Text="Hazır" TextTrimming="CharacterEllipsis"/>
          <Border x:Name="ProgTrack" Grid.Column="2" Width="220" Height="4" CornerRadius="2" Background="{DynamicResource Surface3}" ClipToBounds="True" Margin="0,0,14,0" Opacity="0" VerticalAlignment="Center">
            <Border x:Name="ProgFill" CornerRadius="2" Background="{DynamicResource Acc}" HorizontalAlignment="Left" Width="0">
              <Border.RenderTransform><TranslateTransform/></Border.RenderTransform>
            </Border>
          </Border>
          <Button x:Name="BtnLog" Grid.Column="3" Style="{StaticResource BtnGhost}" Padding="10,3" FontSize="12">
            <StackPanel Orientation="Horizontal"><TextBlock x:Name="LogChevron" Text="&#xE70E;" FontFamily="{StaticResource Icons}" FontSize="10" VerticalAlignment="Center" Margin="0,0,7,0"/><TextBlock Text="Günlük"/></StackPanel>
          </Button>
          <TextBlock x:Name="TxtVer" Grid.Column="4" Foreground="{DynamicResource Dim}" FontSize="11.5" VerticalAlignment="Center" FontFamily="{StaticResource Mono}" Margin="8,0,6,0"/>
        </Grid>
      </Border>

      <!-- BİLDİRİMLER -->
      <StackPanel x:Name="ToastHost" Grid.RowSpan="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,68,18,0" Width="350"/>

      <!-- DİYALOG -->
      <Grid x:Name="DialogHost" Grid.RowSpan="4" Visibility="Collapsed">
        <Border x:Name="DlgDim" Background="{DynamicResource Overlay}" Opacity="0"/>
        <Border x:Name="DlgCard" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line2}" BorderThickness="1" CornerRadius="14"
                MaxWidth="540" MinWidth="400" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,22" RenderTransformOrigin="0.5,0.5" Opacity="0">
          <Border.RenderTransform><ScaleTransform ScaleX="0.94" ScaleY="0.94"/></Border.RenderTransform>
          <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.45"/></Border.Effect>
          <StackPanel>
            <StackPanel Orientation="Horizontal">
              <Border x:Name="DlgIconBg" Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccSoft}" Margin="0,0,12,0">
                <TextBlock x:Name="DlgIcon" FontFamily="{StaticResource Icons}" FontSize="16" Foreground="{DynamicResource Acc}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="&#xE897;"/>
              </Border>
              <TextBlock x:Name="DlgTitle" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
            </StackPanel>
            <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
              <TextBlock x:Name="DlgText" TextWrapping="Wrap" Foreground="{DynamicResource Mut}" LineHeight="21"/>
            </ScrollViewer>
            <StackPanel x:Name="DlgButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
